[Unit]
Description=GPT Image Playground
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gptimage
Group=gptimage
WorkingDirectory=/opt/gpt-image-playground/current
EnvironmentFile=/opt/gpt-image-playground/shared/app.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3008
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gpt-image-playground/shared/generated-images
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
